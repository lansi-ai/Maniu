{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // 本包先做「类型检查」，产物交给 tsdown。
    // 不设 rootDir：base 的 paths 会把 workspace 依赖解析到它们的 src，
    // 一旦设了 rootDir，别人的源文件就会触发 TS6059。
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true
  },
  "include": ["src", "tests"]
}
